{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/netsniper/v2.1/capability-manifest.schema.json",
  "title": "NetSniper v2.1 capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "run_id",
    "sensor",
    "target",
    "execution",
    "collectors",
    "inventory",
    "artifacts",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "netsniper-capability-manifest-v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "netsniper_version",
        "source_commit",
        "bundle_schema_version",
        "classifier_version",
        "taxonomy_version",
        "evidence_profile_version",
        "host_classification_schema_version"
      ],
      "properties": {
        "netsniper_version": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "bundle_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "classifier_version": {
          "type": "string",
          "minLength": 1
        },
        "taxonomy_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence_profile_version": {
          "type": "string",
          "minLength": 1
        },
        "host_classification_schema_version": {
          "const": "netsniper-host-classification-v2"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_scope",
        "normalized_scope",
        "private_scope_enforced"
      ],
      "properties": {
        "requested_scope": {
          "type": "string",
          "minLength": 1
        },
        "normalized_scope": {
          "type": "string",
          "minLength": 1
        },
        "private_scope_enforced": {
          "type": "boolean"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan_profile",
        "status",
        "started_at",
        "completed_at",
        "privilege_context",
        "discovery_methods",
        "partial_reasons",
        "configuration_fingerprint",
        "tools"
      ],
      "properties": {
        "scan_profile": {
          "enum": [
            "quick",
            "balanced",
            "accurate",
            "custom"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "privilege_context": {
          "enum": [
            "privileged",
            "unprivileged",
            "unknown"
          ]
        },
        "discovery_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "partial_reasons": {
          "type": "array",
          "items": {
            "enum": [
              "not_requested",
              "disabled_by_profile",
              "operator_disabled",
              "tool_missing",
              "permission_denied",
              "timeout",
              "execution_error",
              "unsupported_platform",
              "unsupported_target",
              "dependency_unavailable",
              "no_results",
              "partial_output"
            ]
          },
          "uniqueItems": true
        },
        "configuration_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "collectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/collector"
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered_host_count",
        "emitted_host_count",
        "omitted_host_count"
      ],
      "properties": {
        "discovered_host_count": {
          "type": "integer",
          "minimum": 0
        },
        "emitted_host_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_host_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_finalized",
        "manifest_complete",
        "host_inventory_preserved",
        "hashes_verified"
      ],
      "properties": {
        "bundle_finalized": {
          "type": "boolean"
        },
        "manifest_complete": {
          "type": "boolean"
        },
        "host_inventory_preserved": {
          "type": "boolean"
        },
        "hashes_verified": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector_id",
        "requested",
        "status",
        "started_at",
        "completed_at",
        "tool_name",
        "tool_version",
        "artifact_refs",
        "message"
      ],
      "properties": {
        "collector_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "requested": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "unavailable",
            "skipped"
          ]
        },
        "reason_code": {
          "enum": [
            "not_requested",
            "disabled_by_profile",
            "operator_disabled",
            "tool_missing",
            "permission_denied",
            "timeout",
            "execution_error",
            "unsupported_platform",
            "unsupported_target",
            "dependency_unavailable",
            "no_results",
            "partial_output"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "message": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "unavailable",
                  "skipped"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason_code"
            ]
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "size_bytes",
        "required",
        "status"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^/"
          }
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "present",
            "missing",
            "invalid"
          ]
        }
      }
    }
  }
}
